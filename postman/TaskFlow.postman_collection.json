            "url": "{{baseUrl}}/tasks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Build JWT backend\",\n  \"description\": \"Connect React frontend to Spring Boot\",\n  \"projectId\": 1,\n  \"assigneeId\": null,\n  \"priority\": \"HIGH\",\n  \"status\": \"TODO\",\n  \"dueDate\": null,\n  \"estimatedHours\": 6,\n  \"plannedStartAt\": null,\n  \"plannedEndAt\": null,\n  \"content\": \"Acceptance criteria and technical notes\",\n  \"tagIds\": []\n}",
              "options": {
