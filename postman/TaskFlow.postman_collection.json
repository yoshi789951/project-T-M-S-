    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/users"
          }
        },
        {
          "name": "Promote user to manager",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/admin/users/{{userId}}/role?role=MANAGER"
          }
        },
        {
          "name": "Suspend user",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/admin/users/{{userId}}/active?active=false"
          }
        }
      ]
    }
  ]
}
